# ── Database ────────────────────────────────────────────────────────────────
DB_USER=gpe-user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
# Docker local SAFE: 3307 (avoids conflict with MySQL already on 3306)
DB_PORT=3307
DB_NAME=gpe-db

# ── API keys (X-API-Key) — both required to enable middleware ───────────────
API_KEY_APP=
API_KEY_DEV=

# ── Telegram Bot (https://core.telegram.org/bots/api) ────────────────────────
# Create a bot via @BotFather, then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required: validates X-Telegram-Bot-Api-Secret-Token on the webhook
TELEGRAM_WEBHOOK_SECRET=
