# ── Database ────────────────────────────────────────────────────────────────
DB_USER=gpe-user
DB_PASSWORD=azerty1234
DB_HOST=127.0.0.1
# Docker local SAFE: 3307 (évite le conflit avec MySQL déjà sur 3306)
DB_PORT=3307
DB_NAME=gpe-db

# ── Telegram Bot (https://core.telegram.org/bots/api) ────────────────────────
# Créer un bot via @BotFather, puis renseigner :
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret optionnel pour valider le header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ── Email / SMTP (phase suivante — invitation par email) ─────────────────────
# Laisser vide pour désactiver l'envoi email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safe.local
