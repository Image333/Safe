# Variables lues par l'API (os.Getenv). Pas de chargement automatique du fichier :
#   set -a && source .env && set +a && go run .

# ── Database ────────────────────────────────────────────────────────────────
DB_USER=gpe-user
DB_PASSWORD=azerty1234
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gpe-db

# ── API keys (X-API-Key) — both required to enable middleware ───────────────
API_KEY_APP=
API_KEY_DEV=

# ── Telegram Bot (https://core.telegram.org/bots/api) ────────────────────────
# Create a bot via @BotFather, then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required: validates X-Telegram-Bot-Api-Secret-Token on the webhook
TELEGRAM_WEBHOOK_SECRET=
# Préfixes d'URL MinIO autorisés pour blob_url (séparés par des virgules).
# Vide = clips audio non transmis sur Telegram.
TELEGRAM_AUDIO_ALLOWED_URLS=http://minio-service:9000/audio-bucket/,http://82.65.130.61:30900/audio-bucket/
